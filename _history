.change(LedSpriteProperty.Y, 1)\n        basic.pause(200)\n        if EnemyFire.is_touching(Player):\n            game.remove_life(1)\n        if EnemyFire.get(LedSpriteProperty.Y) >= 4:\n            EnemyFire.delete()\nbasic.forever(on_forever)\n","pxt.json":"{\n    \"name\": \"Space Invaders\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"preferredEditor\": \"blocksprj\"\n}\n"}},{"timestamp":1791480866540,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"WvbFe;u%Yx:j45yh}wU7\">Enemy</variable><variable id=\"+s%%%ye:j(GUg]q4PwN/\">Player</variable><variable id=\"eH-{.Q7DI:[8;:;nSR[d\">EnemyFire</variable><variable id=\",yc%YCWxxshmJp2O4z5W\">Shoot</variable><variable id=\"uZ-/7--WTB+d4)Aye{Sf\">sprite</variable></variables><block type=\"pxt-on-start\" x=\"0\" y=\"0\"><statement name=\"HANDLER\"><block type=\"game_set_life\"><value name=\"value\"><shadow type=\"math_number\"><field name=\"NUM\">4</field></shadow></value><next><block type=\"game_set_score\"><value name=\"points\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value><next><block type=\"variables_set\"><field name=\"VAR\" id=\"+s%%%ye:j(GUg]q4PwN/\">Player</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"game_create_sprite\"><value name=\"x\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value><value name=\"y\"><shadow type=\"math_number\"><field name=\"NUM\">4</field></shadow></value></block></value><next><block type=\"variables_set\"><field name=\"VAR\" id=\"WvbFe;u%Yx:j45yh}wU7\">Enemy</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"